# Copy this file to .env and fill in your values

# Claude / Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# LinkedIn Partner API — https://developer.linkedin.com/
# Requires Jobs on LinkedIn partner programme approval.
# Leave blank to disable the LinkedIn adapter (returns empty results, no error).
LINKEDIN_ACCESS_TOKEN=

# Rozee.pk Partner API — contact api@rozee.pk for access.
# Leave blank to disable the Rozee adapter.
ROZEE_API_KEY=
ROZEE_API_BASE=https://api.rozee.pk/v1

# SMTP — optional, for email alert delivery.
# All five fields must be set before any email is sent.
# Users must also set email_enabled=true on each alert they want emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# App
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./job_finder.db
