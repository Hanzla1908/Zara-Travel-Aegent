# ─────────────────────────────────────────────
# CafeBot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ─────────────────────────────────────────────

# ── Anthropic API ──────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model to use (haiku is cheapest; upgrade only if needed)
# Options: claude-haiku-4-5 | claude-sonnet-4-5 | claude-opus-4-5
ANTHROPIC_MODEL=claude-haiku-4-5

# Maximum tokens the model may return per reply
ANTHROPIC_MAX_TOKENS=512

# How many past conversation turns to include in each request (keeps costs low)
ANTHROPIC_MAX_HISTORY_TURNS=6

# ── Server ─────────────────────────────────────
PORT=5000

# Flask environment: development | production
FLASK_ENV=development

# ── Prompt & Data paths ────────────────────────
SYSTEM_PROMPT_PATH=prompts/system-prompt.md
MENU_PATH=data/menu.json
PROMOTIONS_PATH=data/promotions.json
ORDERS_PATH=data/orders.json

# ── Pricing ────────────────────────────────────────────────────────────────────
# Sales tax applied to (subtotal − discount). Use decimal form: 0.10 = 10 %.
TAX_RATE=0.0

# Flat delivery fee added to every delivery order (e.g. 2.50).
DELIVERY_FEE=0.0
